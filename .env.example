# ──────────────────────────────────────────────────────────
#  AI 콘텐츠 스튜디오 — 환경변수 템플릿 (.env.example, 2026-08-21 동기화)
#  · 실제 값은 절대 이 파일에 넣지 말 것 — 복사해서 `.env`로 저장 후 값만 채운다:
#      cp .env.example .env
#  · `.env`는 .gitignore 대상이라 git에 올라가지 않는다. 값은 스튜디오 UI(설정 > API 키)에서도 편집 가능.
#  · 키를 바꾸면 서버 재시작(launchctl kickstart -k gui/$UID/com.gepa.ai-contents-studio).
# ──────────────────────────────────────────────────────────

# ── 서버 기본 ─────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
# GEPA_DATA_DIR 미설정 시 저장소 루트를 데이터 루트로 사용
# GEPA_DATA_DIR=

# ── LLM (Claude) — 기본은 구독(claude CLI) OAuth 인증(키 불필요). API 키로 쓰려면 주석 해제.
# ANTHROPIC_API_KEY=
# CLI 미설치/PATH 문제 시에만 지정
# CLAUDE_CLI_PATH=

# ── OpenAI 이미지 생성(gpt-image — 카드뉴스·쇼츠 씬·썸네일)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# ── 네이버 개발자(검색 API·데이터랩) — 트렌드·연관어·경쟁 SERP 리서치
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 네이버 검색광고(SearchAd) — 월간 검색량·경쟁지수
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# ── 네이버 블로그 — 범용('') 계정(임시저장·성과 수집)·Playwright 세션
NAVER_BLOG_ID=
NAVER_LOGIN_ID=
NAVER_LOGIN_PW=
# 로그인 세션 캐시 파일 경로(미설정 시 저장소 루트의 .naver_session.json)
# NAVER_SESSION_FILE=
# 임시저장 1회 상한(ms) — 기본 30분. 표/코드 스플라이스가 긴 글 대응(2026-08-01)
# NAVER_PUBLISH_TIMEOUT_MS=1800000
# NAVER_ACCOUNTS 는 브랜드별 네이버 계정 blob(JSON) — 값은 스튜디오 UI '키' 탭/브랜드 연결이 관리, 직접 채우지 말 것

# ── 유튜브 — 데이터 API 키(쇼츠 성과 수집·그라운딩) + OAuth 클라이언트(쇼츠 업로드)
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_TOKENS 는 브랜드별 refresh token 저장용 — 값은 스튜디오 UI가 관리, 직접 채우지 말 것

# ── 메타·인스타그램(인스타그램 로그인 방식, 2026-07-20 전환) — 릴스·카드뉴스 발행
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 페이스북 페이지 발행용 별도 메타 앱(인스타 앱과 다름)
META_APP_ID=
META_APP_SECRET=
# 비즈니스용 Facebook 로그인 구성 ID(대시보드에서 생성)
# META_FB_CONFIG_ID=
# OAuth 콜백 전용 HTTPS 리스너 포트(미설정 시 PORT+1)
# META_HTTPS_PORT=
# META_TOKENS 는 브랜드별 페이지·IG 토큰 저장용 — 값은 스튜디오 UI가 관리, 직접 채우지 말 것
# 메타 발행 시 'AI 정보' 자기 공개 라벨(IG 게시물·릴스 + FB 릴스=is_ai_generated). 끄려면 0
META_AI_LABEL=1

# ── 쇼츠 자막·제목(선택 — 기본: 하단 50%·70px(훅 84px)·키워드 강조·테두리, 사용자 확정 2026-07-30) ──
# 자막 하단 여백 %(5~60). 유튜브·릴스 하단 UI(~25%) 회피 — 종전값 32/20
SHORTS_CAPTION_BOTTOM_PCT=50
# 자막 글자 크기 px — 일반 씬(32~120)·훅 씬(32~140)
SHORTS_CAPTION_FONT_PX=70
SHORTS_CAPTION_HOOK_FONT_PX=84
# 자막 속 핵심 키워드 노란 강조. 끄려면 0
SHORTS_CAPTION_KEYWORD=1
# 자막 글자 검은 테두리(밝은 배경 시인성). 끄려면 0
SHORTS_CAPTION_OUTLINE=1
# 상단 제목 캘리 오버레이 — 썸네일과 같은 문구의 손글씨를 별도 생성(투명 PNG)해 전 씬 고정. 끄려면 0
SHORTS_TITLE_OVERLAY=1
# 제목 상단 오프셋 %(0~20) — 5=유튜브·릴스 상단 UI(~8%) 회피 절충
SHORTS_TITLE_TOP_PCT=5
# 제목 폭 %(30~100) — 74=2줄 위계(키워드 라벨+훅) 재보정값(2026-07-31, 코드 기본과 일치). 90은 1줄 시절 값
SHORTS_TITLE_WIDTH_PCT=74
# 총 길이 상한 초(20~180, 기본 60 — 사용자 확정 2026-08-14). 초과 대본은 LLM 압축+결정적 트리밍으로 예산 보장
# SHORTS_MAX_DURATION_SEC=60

# ── fal.ai — 쇼츠 씬 I2V + 발행용 공개 URL 호스팅(릴스 영상·카드뉴스 이미지)
FAL_KEY=
# SHORTS_I2V=fal
# SHORTS_I2V_MODEL=fal-ai/wan/v2.2-5b/image-to-video
SHORTS_I2V_MAX_CLIPS=1  # 씬 클립 상한(코드 기본 2) — 1=훅 컷만(과금 캡), 사용자 확정 2026-08-12

# ── ElevenLabs TTS(2026-07-22) — 쇼츠 내레이션(미설정 시 OpenAI TTS 폴백)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_SPEED=1.0
# TTS_PROVIDER=openai

# ── 블로그 스킬(Python 서브프로세스 — 이미지 생성·네이버 발행). 없으면 '(블로그 스킬 비활성)' 폴백 ──
# 가상환경 생성: python3 -m venv scripts/blog_skills/venv && scripts/blog_skills/venv/bin/pip install -r scripts/blog_skills/requirements.txt
BLOG_PYTHON=scripts/blog_skills/venv/bin/python3
BLOG_SCRIPTS_DIR=scripts/blog_skills
AGENT_TOOL_LOOP=true
# BLOG_AUTO_IMAGE=true
AUTO_NAVER_DRAFT=false # 기본 off(2026-08-27 사용자 확정): 모든 블로그 글은 수동 검토 후 버튼으로 임시저장. true 로 켜면 SEO 하한·사실 게이트 통과 시 자동 저장

# ── 자율 사이클·스케줄 ─────────────────────────────────────
AUTO_CYCLE_MINUTES=30
RESEARCH_CYCLE_HOURS=8
CONTENT_CADENCE_PER_WEEK=14  # 주 14편(일 2편) — 정각 오토런 2회와 정합, 사용자 확정 2026-08-12
AUTO_SHORTS_PER_DAY=0   # 단독 자율 쇼츠 끔 — 블로그 세트 파생만, 사용자 확정 2026-08-12
AUTO_CARDNEWS_PER_DAY=0  # 단독 자율 카드 끔 — 블로그 세트 파생만, 사용자 확정 2026-08-12
# 정각 오토런(사용자 결정 2026-08-10) — 매일 지정 시각 각 1편 즉시 생산(빈값=off)
AUTORUN_TIMES=06:00,18:00
# 성과 동기화 가동 시각(미설정 시 스케줄러 비활성)
PERFORMANCE_SYNC_TIME=07:30
# 일일 브리핑 발송 시각(미설정 시 브리핑 비활성) — 성과 동기화(수 분 소요)보다 뒤라야 그날 숫자가 담긴다
DAILY_BRIEFING_TIME=08:00
# 네이버 통계 수집(일일 추적)을 헤드리스로 — 크롬 창 없이 백그라운드 수집(세션 쿠키 재사용). 창 보고 싶으면 0
NAVER_STATS_HEADLESS=1

# ── 주제 선정 수요 게이트(2026-08-26) ──────────────────────
# 후보 keyword 의 네이버 절대 검색량(검색광고)·시즌 지수(데이터랩 13개월)를 보고 기각·후순위화한다.
# 키(검색광고 3종·네이버 Client ID/Secret) 없거나 조회 실패면 자동 생략(fail-open). 끄려면 off
# TOPIC_DEMAND_GATE=off
# 월 검색량 하한 — 후보와 계열 최대 연관어가 둘 다 이 미만이면 기각(실측 2026-08-26: 우리 롱테일 0~30/월)
# TOPIC_DEMAND_MIN_VOLUME=30
# 시즌 지수(0~1) 하한 — 미만이면 비수기로 후순위(기각 아님). 대안이 없으면 그대로 채택된다
# TOPIC_DEMAND_MIN_SEASON=0.25

# ── 콘텐츠 품질 게이트 ────────────────────────────────────
# 사실 게이트(2026-08-26) — 블로그 본문 주장을 브리프·주입 근거와 대조해 무근거·모순이면 보류(hold).
# 보류·판정실패면 자동 네이버 임시저장만 건너뛴다(검토 탭·텔레그램 버튼은 그대로 발행 가능).
# off 로 두면 블로그 게이트 + 카드·쇼츠 원문 정합 검사를 함께 끄고, 다음 런에서 조각의 기존 보류도 해제된다.
# FACT_GATE=off
# 한 편에서 판정할 주장 수 상한(기본 20, 5~40 로 자동 클램프). 늘리면 정확도↑·토큰↑
# FACT_GATE_MAX_CLAIMS=20
# 엄격 모드(2026-08-27 복귀 스위치). 기본 off — 수치·시기·약제·법령·가격·통계·경험 주장만 보류하고,
# 그 밖의 무근거 일반 상식 문장은 참고(unverified)로 통과시킨다. 1 로 두면 무근거를 전부 보류하던 예전 동작.
# FACT_GATE_STRICT=1
# 시기·수치 원문 대조(2026-08-27 권고 1) — 파생 카드·쇼츠에 원문(블로그)에 없는 월·절기·수치가 새로
# 들어갔는지 결정적으로 대조한다. 검출은 기존 정합 수정 라운드에 합류하고(발행 차단 없음), 잔존은
# 텔레그램에 '⚠ 원문과 다른 시기·수치 N건'으로 표시. 쇼츠 stat 오버레이만 원문에 없으면 결정적으로 제거.
# off 로 두면 검출과 오버레이 제거를 함께 끈다.
# TIMING_PARITY=off
# 블로그 문체 린트(2026-08-27 권고 3) — 본문에서 대비문 과다·합쇼체 비율·유보 중첩·명사형 목록 종결을
# 결정적으로 검사하고, 지적이 있으면 작가가 '그 지적만' 고치는 수정 1회를 돌린다(사실 게이트보다 먼저 —
# 게이트는 수정된 최종 본문을 판정한다). 발행은 막지 않고, 수정 뒤 잔존은 텔레그램 '✍ 문체 N건 잔존' 한 줄.
# off 로 두면 검사와 수정 라운드를 함께 끈다(글당 LLM 콜 1회 절약).
# BLOG_STYLE_LINT=off
# 요약·설명 메타투 린트(2026-08-27 권고 2) — 블로그 meta(검색 스니펫)와 쇼츠 description(=인스타 캡션)이
# "정리했습니다/담았어요/알아봅니다" 로 끝나는지 결정적으로 검사한다. 블로그는 같은 포장 콜을 1회만 다시
# 부르고(깨끗해진 meta 만 갈아끼움), 쇼츠는 새 콜 없이 기존 수정 라운드에 지적을 얹는다. 발행은 막지 않는다.
# off 로 두면 두 검사와 블로그 재시도 콜이 함께 멈춘다(블로그 포장 LLM 콜 최대 1회로 복귀).
# META_SUMMARY_LINT=off
# 마무리·제목 문형 로테이션(2026-08-27 권고 5) — 카드뉴스 마무리 장과 블로그 마무리 문단에 '최근 5편이 쓴
# 마무리 원문'을 보여 주고 같은 문형으로 닫지 못하게 하며, 쇼츠 제목 후보 유형을 5종 풀(정보형·후킹형·
# 질문형·결론형·장면형)에서 런마다 3개 고른다(질문형은 최근 3편 중 1편 이하). 여기에 더해 쇼츠의 결정적
# 텍스트 손질 2종 — 자막 딱지 린트(screenText 가 "정의·구분법·요약"으로 끝나면 수정 라운드에 합류)와
# 고유어 월 정규화(title·titles·description·screenText·hashtags 의 "시월"→"10월") — 도 이 스위치를 본다.
# off 로 두면 세 주입이 빠지고 쇼츠 제목 후보는 종전 고정 3종으로 돌아가며, 위 손질 2종도 함께 멈춘다.
# 카드 [말맛] 마무리 지시와 쇼츠 제목 유형 정의 줄도 base 문구로 되돌아간다
# (= 2026-08-27 권고 5 전체를 되돌리는 레버 하나 — 프롬프트 문구까지 종전과 같아진다).
# 주의 — 블로그 마무리 주입은 스타일 다양성 가드 가족(도입·상투구·어간 회피)과 같은 자리라 WRITER_STYLE_DIVERGE=off
# 로도 함께 꺼진다(카드·쇼츠 로테이션은 VOICE_ROTATION 만 본다).
# VOICE_ROTATION=off
# 골격 다양화(2026-08-27 권고 4) — 런마다 '구조 시드'를 한 벌 뽑아 골격을 흔든다: 블로그는 도입 유형
# (장면·질문·주장·대비)·중심 명제 인용(">> " 따옴표) 자리(없음·훅 직후·중간·마무리 직전)·표/체크리스트/
# 예고 중 2개만 켜기를 [이번 글 구조] 블록으로 작가에게 주입하고, 카드뉴스는 본문 줄 수(2~5)·해시태그
# 수(10~15), 쇼츠는 씬 수(4~6)를 그 시드에서 받는다. 리비전 런은 sessions/<runId>/structure.json 으로
# 원 런 시드를 승계해 개정이 골격을 바꾸지 않는다.
# off 로 두면 시드가 고정값(훅 직후 인용·표+체크리스트·예고 없음·카드 4줄·해시태그 12개·쇼츠 5씬)이 되고,
# [이번 글 구조] 블록 주입과 카드의 줄 수·해시태그 지시 두 줄도 통째로 빠지며 작가 지침 문구가 base 로
# 되돌아간다(도입 "독자의 상황·질문으로 바로 시작한다"·인용구 "글당 1곳, 도입 훅 직후가 최적"·프레임
# "글당 1곳"·표 상시 권장) = 프롬프트까지 문자 그대로 종전 동작
# (쇼츠 씬 수는 40초 상한 역산에 다시 걸려 실제 4~5씬 — 6씬은 상한 48초부터).
# STRUCTURE_VARIETY=off

# ── 알림(선택 — 미설정 시 알림 no-op) ─────────────────────
# NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 조각별 ready(검토 대기) 알림 — 완성 순간 push(텔레그램이면 발췌·앨범·영상 미리보기 동봉). 끄려면 0
# NOTIFY_CONTENT_READY=1
# 텔레그램 봇 수신 폴러 — 알림 속 발행 버튼·수정요청 답장 처리(자격 설정 시에만 실동작). 끄려면 0
# TELEGRAM_BOT=1
# 알림 속 검토 링크의 베이스 URL — 폰에서 열려면 Tailscale 주소(예: https://mac.tailnet.ts.net). 미설정 시 http://127.0.0.1:PORT
# STUDIO_BASE_URL=

# ── 예산(선택) ────────────────────────────────────────────
# MONTHLY_BUDGET_USD=0

# ── 그라운딩 커넥터(선택) ──────────────────────────────────
LAW_API_KEY=
DART_API_KEY=

# ── 접근 제어(선택) ────────────────────────────────────────
# Tailscale 등 외부 접근 허용 호스트(쉼표 구분)
# ALLOWED_HOSTS=
# 설정 시 API 요청에 Bearer 인증 필요(기본은 게이트 없음)
# AUTH_TOKEN=
